# Mock APIs configuration. Copy to `.env` and adjust. Placeholders only - never commit real secrets.

# --- API server ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Public origin of the API (no trailing slash, no /api/v1). Used for image URLs, docs links, and the OpenAPI server.
PUBLIC_API_URL=http://localhost:4000
# Public URL of the documentation website (optional, shown in API discovery).
WEB_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/mockapis
# Seed the database on startup when it is empty or the fixtures changed.
AUTO_SEED=true

# --- HTTP ---------------------------------------------------------------------
# Comma-separated allowed origins, or * for any origin (credentials are never allowed).
CORS_ORIGINS=*
# Express "trust proxy": false when exposed directly, or the number of reverse proxies in front (e.g. 1).
# Must be correct for per-IP rate limiting to see real client IPs.
TRUST_PROXY=false
BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=15000
DOCS_ENABLED=true
LOG_LEVEL=info

# --- Pagination ---------------------------------------------------------------
DEFAULT_PAGE_LIMIT=30
MAX_PAGE_LIMIT=100

# --- Rate limiting (per client IP) --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Stricter limit for requests that use ?delay or /test/delay.
RATE_LIMIT_DELAY_MAX=20
# memory (single instance) or mongo (shared across instances).
RATE_LIMIT_STORE=memory

# --- Demo JWT -----------------------------------------------------------------------
# Required in production (at least 32 random characters each, e.g. `openssl rand -base64 48`).
# In development, leave them unset to use built-in development-only secrets.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_MINS=30
JWT_REFRESH_EXPIRES_MINS=10080

# --- Web app build arguments (used by docker compose) -------------------------------
# For `pnpm dev`, the web app reads apps/web/.env instead (see apps/web/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
