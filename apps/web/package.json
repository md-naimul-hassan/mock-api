{
  "name": "@mockapis/web",
  "version": "1.0.0",
  "private": true,
  "description": "Mock APIs documentation website and API playground (Next.js).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @mockapis/api-spec run build && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mockapis/api-spec": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
