{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "apps/api/Dockerfile"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ready",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
